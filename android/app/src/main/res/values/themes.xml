<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Тёмная тема по умолчанию (Material 3, без Compose). -->
    <style name="Theme.Colemailer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/mint</item>
        <item name="colorOnSecondary">@color/mint_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/red</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialCardViewStyle">@style/Widget.Colemailer.Card</item>
        <item name="materialAlertDialogTheme">@style/Theme.Colemailer.Dialog</item>
        <item name="bottomNavigationStyle">@style/Widget.Colemailer.BottomNav</item>
        <item name="textInputStyle">@style/Widget.Colemailer.TextInput</item>
    </style>

    <style name="Theme.Colemailer.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/on_surface</item>
    </style>

    <style name="Widget.Colemailer.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_1</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Colemailer.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Colemailer.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_1</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="hintTextColor">@color/on_surface_muted</item>
    </style>

    <style name="Widget.Colemailer.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.Colemailer.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Widget.Colemailer.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="backgroundTint">@color/red</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>
