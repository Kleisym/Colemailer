<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/auth_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_auth_title"
            style="@style/TextAppearance.Colemailer.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Код из Telegram" />

        <TextView
            android:id="@+id/tv_auth_hint"
            style="@style/TextAppearance.Colemailer.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="Введите код, который пришёл в чат «Telegram»." />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_auth_input"
            style="@style/Widget.Colemailer.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/auth_hint_code">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_auth_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_auth_error"
            style="@style/TextAppearance.Colemailer.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/red"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auth_cancel"
                style="@style/Widget.Colemailer.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/auth_btn_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auth_ok"
                style="@style/Widget.Colemailer.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/auth_btn_ok" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Colemailer.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/auth_note" />
    </LinearLayout>
</ScrollView>
