<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/TextAppearance.Colemailer.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_antispam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_antispam"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_autosub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_autosub"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_quiet_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_quiet_logs"
                    android:textColor="@color/on_surface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_folder"
                    style="@style/Widget.Colemailer.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_folder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_folder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_settings"
                    style="@style/Widget.Colemailer.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_save_settings" />

                <TextView
                    style="@style/TextAppearance.Colemailer.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_restart_note" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/TextAppearance.Colemailer.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_background" />

                <TextView
                    android:id="@+id/tv_bg_report"
                    style="@style/TextAppearance.Colemailer.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    tools:text="✅ Уведомления разрешены" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fix_all"
                    style="@style/Widget.Colemailer.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_fix" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_root_grants"
                    style="@style/Widget.Colemailer.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_root_grants" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_autostart"
                    style="@style/Widget.Colemailer.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_open_autostart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mark_autostart"
                    style="@style/Widget.Colemailer.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_mark_autostart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_app_details"
                    style="@style/Widget.Colemailer.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_app_details" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/TextAppearance.Colemailer.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_version" />

                <TextView
                    android:id="@+id/tv_version"
                    style="@style/TextAppearance.Colemailer.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="3.0.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manual_api"
                    style="@style/Widget.Colemailer.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_manual_api" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_auto_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/settings_auto_update"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/tv_update_status"
                    style="@style/TextAppearance.Colemailer.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="Установлена 3.2.1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_check_update"
                    style="@style/Widget.Colemailer.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_check_update" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
